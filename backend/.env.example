# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=your_token_here
# Optional. Default is openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b

# PostgreSQL Settings
POSTGRES_DB=chatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@db:5432/chatbot
